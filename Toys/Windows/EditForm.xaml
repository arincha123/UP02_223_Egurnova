<Window x:Class="Toys.Windows.EditForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Toys.Windows"
        mc:Ignorable="d"
        Title="EditForm" Height="450" Width="800" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="Cover" Source="{Binding CurProd.CoverPath}"
               Grid.Column="0"
               Grid.RowSpan="7"
               Width="160"
               Height="300"
               Stretch="Uniform"
               Margin="5"/>

        
        
        <TextBlock Text="Фото товара: "
                   Grid.Column="1"
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"/>

        <!--Нужен Grid-->
        
        <WrapPanel Grid.Column="2"
                   Grid.Row="0"
                   VerticalAlignment="Center">
            
            <TextBox x:Name="Path"
                 
                 Width="auto"
                 Height="20"
                 
                 Margin="5 0"/>
            <Button x:Name="AddPhotoBtn"/>


        </WrapPanel>
        
        

        <TextBlock Text="Наименование товара: "
                   Grid.Column="1"
                   Grid.Row="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"/>

        <TextBox x:Name="ProdName"
                Grid.Column="2"
                Grid.Row="1"
                Width="auto"
                Height="20"
                VerticalContentAlignment="Center"
                 Margin="5 0"/>

        <TextBlock Text="Категория товара: "
                   Grid.Column="1"
                   Grid.Row="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"/>

        <ComboBox x:Name="ProdCat"
                Grid.Column="2"
                Grid.Row="2"
                Width="auto"
                Height="20"
                VerticalContentAlignment="Center"
                  Margin="5 0"/>

        <TextBlock Text="Описание товара: "
                   Grid.Column="1"
                   Grid.Row="3"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"/>

        <TextBox x:Name="ProdDesc"
                Grid.Column="2"
                Grid.Row="3"
                 Grid.RowSpan="2"
                Width="auto"
                Height="auto"
                 Margin="5"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                 TextWrapping="Wrap"/>

        <TextBlock Text="Производитель: "
                   Grid.Column="1"
                   Grid.Row="5"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"/>

        <TextBox x:Name="ProdManuf"
                Grid.Column="2"
                Grid.Row="5"
                Width="auto"
                Height="20"
                VerticalContentAlignment="Center"
                Margin="5 0"/>

        <TextBlock Text="Поставщик: "
                   Grid.Column="1"
                   Grid.Row="6"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"/>

        <ComboBox x:Name="ProdSup"
                    Grid.Column="2"
                    Grid.Row="6"
                    Width="auto"
                    Height="20"
                    VerticalContentAlignment="Center"
                      Margin="5 0"/>

        <TextBlock Text="Цена товара: "
           Grid.Column="1"
           Grid.Row="7"
           VerticalAlignment="Center"
           HorizontalAlignment="Stretch"/>

        <TextBox x:Name="ProdPrice"
            Grid.Column="2"
            Grid.Row="7"
            Width="auto"
            Height="20"
            VerticalContentAlignment="Center"
            Margin="5 0"/>

        <TextBlock Text="Единица измерения товара: "
           Grid.Column="1"
           Grid.Row="8"
           VerticalAlignment="Center"
           HorizontalAlignment="Stretch"/>

        <TextBox x:Name="ProdUnit"
            Grid.Column="2"
            Grid.Row="8"
            Width="auto"
            Height="20"
            VerticalContentAlignment="Center"
            Margin="5 0"/>

        <TextBlock Text="Количество на складе: "
           Grid.Column="1"
           Grid.Row="9"
           VerticalAlignment="Center"
           HorizontalAlignment="Stretch"/>

        <TextBox x:Name="ProdQuant"
            Grid.Column="2"
            Grid.Row="9"
            Width="auto"
            Height="20"
            VerticalContentAlignment="Center"
            Margin="5 0"/>

        <TextBlock Text="Скидка: "
           Grid.Column="1"
           Grid.Row="10"
           VerticalAlignment="Center"
           HorizontalAlignment="Stretch"/>

        <TextBox x:Name="ProdDis"
            Grid.Column="2"
            Grid.Row="10"
            Width="auto"
            Height="20"
            VerticalContentAlignment="Center"
            Margin="5 0"/>

        <Button x:Name="SaveBtn"
                Grid.ColumnSpan="3"
                Grid.Row="11"
                Width="120"
                Height="30"
                Content="Сохранить"
                Margin="5 0"
                HorizontalAlignment="Center" 
                Click="SaveBtn_Click"/>

    </Grid>
</Window>
